+#if defined(__OpenBSD__)
+/* Adding IPv6 addresses makes the kernel queue multicast listener reports
+ * on tun(4).  Discard them before the test starts, otherwise packetdrill
+ * treats them as unexpected outbound packets.
+ */
+static void drain_tun(struct local_netdev *netdev)
+{
+	struct pollfd pfd;
+	char buffer[65536];
+
+	memset(&pfd, 0, sizeof(pfd));
+	pfd.fd = netdev->tun_fd;
+	pfd.events = POLLIN;
+	while (poll(&pfd, 1, 0) > 0) {
+		if (read(netdev->tun_fd, buffer, sizeof(buffer)) <= 0)
+			break;
+		pfd.revents = 0;
+	}
+}
+#endif /* defined(__OpenBSD__) */
