-/* Rewrite the TCP sequence number echoed by the ICMP packet.
- * The Linux TCP layer ignores ICMP messages with bogus sequence numbers.
+/* Fill in the addresses in the IP header echoed by an ICMP error.  The
+ * kernel uses this header to find the connection that triggered the error.
+ */
+static void map_inbound_icmp_addresses(struct socket *socket,
+				       struct packet *live_packet)
+{
+	if (live_packet->icmpv4 != NULL) {
+		struct ipv4 *ipv4 = packet_echoed_ipv4_header(live_packet);
+
+		ip_to_ipv4(&socket->live.local.ip, &ipv4->src_ip);
+		ip_to_ipv4(&socket->live.remote.ip, &ipv4->dst_ip);
+	} else if (live_packet->icmpv6 != NULL) {
+		struct ipv6 *ipv6 = packet_echoed_ipv6_header(live_packet);
+
+		ip_to_ipv6(&socket->live.local.ip, &ipv6->src_ip);
+		ip_to_ipv6(&socket->live.remote.ip, &ipv6->dst_ip);
+	}
+}
+
+/* Rewrite the TCP sequence number and ports echoed by the ICMP packet.
+ * The kernel ignores ICMP messages that do not match the connection.
  */
 static int map_inbound_icmp_tcp_packet(
 	struct socket *socket,
@@ -705,25 +724,40 @@
 	bool encapsulated,
