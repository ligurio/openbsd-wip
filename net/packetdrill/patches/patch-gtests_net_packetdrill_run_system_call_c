+/* Allocate a buffer for an ellipsis argument, or pass a NULL pointer
+ * for a scripted NULL buffer. */
+static int buffer_arg(struct expression_list *args, int index, int count,
+		      char **buf, char **error)
+{
+	struct expression *expression = get_arg(args, index, error);
+
+	if (expression == NULL)
+		return STATUS_ERR;
+	if (expression->type == EXPR_NULL) {
+		*buf = NULL;
+		return STATUS_OK;
+	}
+	if (check_type(expression, EXPR_ELLIPSIS, error))
+		return STATUS_ERR;
+	*buf = calloc(count, 1);
+	if (*buf == NULL) {
+		asprintf(error, "out of memory allocating %d-byte buffer", count);
+		return STATUS_ERR;
+	}
+	return STATUS_OK;
+}
