+#elif defined(__OpenBSD__)
+static bool is_thread_sleeping(pid_t process_id, int thread_id)
+{
+	char errbuf[256];
+	kvm_t *kd;
+	struct kinfo_proc *procs;
+	int count = 0;
+	int i;
+	bool is_sleeping = false;
+
+	kd = kvm_openfiles(NULL, NULL, NULL, KVM_NO_FILES, errbuf);
+	if (kd == NULL)
+		die("kvm_openfiles() failed: %s\n", errbuf);
+
+	procs = kvm_getprocs(kd,
+			     KERN_PROC_PID | KERN_PROC_SHOW_THREADS,
+			     process_id, sizeof(struct kinfo_proc), &count);
+	if (procs == NULL)
+		die("kvm_getprocs() failed\n");
+
+	for (i = 0; i < count; ++i) {
+		if (procs[i].p_tid == thread_id) {
+			is_sleeping = (procs[i].p_stat == SSLEEP &&
+				  strcmp(procs[i].p_wmesg, "fsleep") != 0);
+			break;
+		}
+	}
+	if (i == count)
+		die("unable to find thread %d\n", thread_id);
+
+	kvm_close(kd);
+	return is_sleeping;
+}
