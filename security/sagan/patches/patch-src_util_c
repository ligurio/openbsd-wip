+     * are not supported so PCRE JIT stays disabled.
+     */
+    return 0;
+#else
     int retval = 1;
     void *ptr;
     ptr = mmap(0, getpagesize(), PROT_READ|PROT_WRITE, MAP_ANON|MAP_SHARED, -1, 0);
@@ -1306,6 +1314,7 @@
             munmap(ptr, getpagesize());
         }
     return retval;
+#endif
 }
